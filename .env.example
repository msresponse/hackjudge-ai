# Optional: GitHub personal access token increases API rate limits.
# Use a fine-grained token with read-only public repository access where possible.
GITHUB_TOKEN=

# Optional OpenAI-compatible chat completions endpoint.
# Examples vary by provider. Base URL may be https://provider.example/v1
# The app appends /chat/completions unless you include that suffix already.
AI_BASE_URL=
AI_API_KEY=
# Comma-separated list of models selected randomly for evaluation:
AI_MODELS=gemma-4-26b-a4b-it, gemma-4-31b-it, gemini-3.8-flash, gemini-3.6-flash, gemini-3-flash-preview, gemini-3.5-flash-lite
AI_MODEL=gemma-4-26b-a4b-it

# Optional path for SQLite database
# DATABASE_PATH=hackjudge.db

# Administrative passkey for /admin
ADMIN_ACCESS_KEY=hackjudge_admin_2026
